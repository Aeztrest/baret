    "deploy-vault": "tsx scripts/deploy.ts",
    "setup-vault": "tsx scripts/setup.ts",
    "agent-key": "tsx scripts/agent-key.ts",
    "agent": "tsx src/agent-cli.ts"
  },
  "dependencies": {
    "@baret/chains": "workspace:*",
    "@baret/core": "workspace:*",
    "near-api-js": "7.4.0"
