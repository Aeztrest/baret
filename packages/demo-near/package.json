{
  "name": "@baret/demo-near",
  "version": "0.1.0",
  "private": true,
  "description": "The NEAR demo (ADR-0010, ADR-0011): testnet setup scripts for the Baret vault and an AI agent that asks Baret before every payment and pays through the vault with a function call key.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "keys": "tsx scripts/keys.ts",
    "accounts": "tsx scripts/accounts.ts",
    "deploy-vault": "tsx scripts/deploy.ts",
    "setup-vault": "tsx scripts/setup.ts",
    "new-shop": "tsx scripts/new-shop.ts",
    "agent-key": "tsx scripts/agent-key.ts",
    "upgrade-vault": "tsx scripts/upgrade.ts",
    "update-vault": "tsx scripts/update.ts",
    "verify-vault": "tsx scripts/verify-vault.ts",
    "verify": "tsx scripts/verify.ts",
    "evm-setup": "tsx scripts/evm-setup.ts",
    "intents-check": "tsx scripts/intents-check.ts",
    "market-agent": "tsx scripts/market-agent.ts",
    "agent": "tsx src/agent-cli.ts"
  },
  "dependencies": {
    "@baret/agent-market": "workspace:*",
    "@baret/chains": "workspace:*",
    "@baret/content": "workspace:*",
    "@baret/core": "workspace:*",
    "@noble/hashes": "2.2.0",
    "@scure/base": "2.2.0",
    "near-api-js": "7.4.0"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
