# Copy to .env.near (gitignored) in this folder. Testnet only.
NEAR_NETWORK=testnet
# NEAR_RPC_URL=https://rpc.testnet.near.org
# BARET_API_URL=https://baret-api-staging.onrender.com
# The owner: a funded testnet account and its full access key (ed25519:...).
NEAR_OWNER_ID=
NEAR_OWNER_KEY=
# Written by `pnpm keys`: NEAR_VAULT_ID/KEY, NEAR_AGENT_ID/KEY, NEAR_SHOP_ID/KEY, NEAR_AGENT_FC_KEY
# Optional: the account a prompt injection asks the agent to pay.
# NEAR_ATTACKER_ID=drain-it-all.testnet
# NEAR Intents check (mainnet, nothing is signed): an account that holds some wNEAR.
# NEAR_INTENTS_ACCOUNT=
# NEAR_INTENTS_API=https://1click.chaindefuser.com
