{
  "name": "@baret/core",
  "version": "0.2.0",
  "description": "Baret's shared contract: chain identifiers, effects, findings, the GuardPolicy v2 schema, the verdict and the chain adapter interfaces. No chain library inside.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aeztrest/baret.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "node ../../tooling/clean.mjs dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
