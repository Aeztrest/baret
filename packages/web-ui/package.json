{
  "name": "@baret/web-ui",
  "version": "0.2.0",
  "private": true,
  "description": "The web signature layer shared by the web app and the web wallet: type scale, layout frame, motion, reveals, parallax, smooth scroll, the eyelet cursor, the fonts and the verdict blocks. Consumed as TypeScript source, never built.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./styles/*": "./src/styles/*",
    "./vite": {
      "types": "./vite.d.mts",
      "default": "./vite.mjs"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@baret/content": "workspace:*",
    "@baret/ui": "workspace:*",
    "lenis": "1.3.27",
    "lucide-react": "1.70.0",
    "motion": "14.10.1"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "vite": "8.3.6"
  }
}
