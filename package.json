{
  "name": "baret",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Baret: a pre-signing transaction firewall and agent spend-limit layer. NEAR (vault, Chain Signatures, Intents, Agent Market) and EVM live on testnet; Stellar and Casper being ported.",
  "license": "MIT",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "docs:check": "node tooling/docs-check.mjs",
    "secrets:check": "node tooling/secrets-check.mjs",
    "imports:check": "node tooling/import-rules.mjs",
    "check": "pnpm lint && pnpm lint:copy && pnpm typecheck && pnpm imports:check && pnpm test && pnpm docs:check && pnpm secrets:check",
    "lint:copy": "pnpm --filter @baret/content lint:copy",
    "near:verify": "pnpm --filter @baret/demo-near verify"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
