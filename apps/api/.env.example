# Copy to apps/api/.env for local runs. Every variable: docs/operations/environments.md.

# A chain is served only when its RPC URL is set.
CHAIN_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# Node for debug_traceCall when the main RPC lacks it (Alchemy's free tier does). Empty: the main RPC.
CHAIN_MONAD_TESTNET_TRACE_RPC_URL=
CHAIN_MONAD_RPC_URL=
CHAIN_MONAD_TRACE_RPC_URL=

PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
BARET_ENV=local
# Comma-separated. Empty: /v1 is open (refused when BARET_ENV=production).
BARET_API_KEYS=
BARET_CORS_ORIGINS=
BARET_RATE_LIMIT_PER_MINUTE=120
BARET_REQUEST_TIMEOUT_MS=8000
BARET_VERDICT_TTL_SECONDS=30
# Proxy trust for per-client rate limits (apps/api/src/client.ts). Empty: Fastify's req.ip.
BARET_PROXY_DIRECT_HOPS=
BARET_PROXY_EDGE_HOPS=
BARET_EDGE_SECRET=
