{
  "name": "@baret/api",
  "version": "0.2.0",
  "private": true,
  "description": "The Baret HTTP API: the engine over /v1/analyze for every enabled chain.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@baret/chain-evm": "workspace:*",
    "@baret/chain-near": "workspace:*",
    "@baret/chains": "workspace:*",
    "@baret/core": "workspace:*",
    "@baret/engine": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
